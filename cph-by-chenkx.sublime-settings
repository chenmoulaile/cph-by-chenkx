{
	// ================= cph-by-chenkx 设置（中文注释版） =================
	// 保存即生效。建议把要改的项复制到 User 设置里覆盖（Preferences ->
	// Package Settings -> cph-by-chenkx -> Settings），升级插件不会丢配置。

	// 界面语言: "zh" 中文 / "en" 英文（也可用命令面板的 Toggle language 切换）
	"language": "zh",

	// ================= 各语言编译/运行配置 =================
	// 可用占位符:
	//   {source_file}     源代码完整路径
	//   {source_file_dir} 源代码所在目录
	//   {file_name}       不带扩展名的文件名
	//   {args}            附加命令行参数
	//   {extra_sources}   多文件题目：额外的源文件（见 extra_sources 设置）
	//   {include_dirs}    额外 -I 目录（见 include_dirs 设置）
	// 注意: compile_cmd 里 "-o" 后面必须紧跟输出文件名 "{file_name}"，
	//       顺序写错会导致编译失败！
	// 默认命令使用正斜杠，Linux/macOS/Windows 都可用；Windows 想用反斜杠路径
	// 可在 "cph-by-chenkx (Windows).sublime-settings" 里覆盖整个 run_settings。
	"run_settings": [
		{
			"name": "C++",
			"extensions": ["cpp"],
			// 编译命令；{extra_sources} / {include_dirs} 用不到时删掉即可
			"compile_cmd": "g++ \"{source_file}\" {extra_sources} {include_dirs} -std=c++23 -o \"{file_name}.exe\" -DLOCAL",
			// 运行命令（编译产物在源代码目录下）
			"run_cmd": "\"{source_file_dir}/{file_name}.exe\" {args}",
			// 单个测试的时间限制(毫秒) / 内存限制(MB)，超限判 TLE / MLE
			"time_limit_ms": 2000,
			"memory_limit_mb": 256,
			// 多文件题目：把同目录其它源文件一起编译（glob 通配，可留空）
			"extra_sources": [],
			// 额外头文件目录（可留空）
			"include_dirs": []
		},
		{
			"name": "Python",
			"extensions": ["py"],
			// Python 无需编译，置为 null
			"compile_cmd": null,
			"run_cmd": "python \"{source_file}\"",
			"time_limit_ms": 5000,
			"memory_limit_mb": 256
		},
		{
			"name": "Java",
			"extensions": ["java"],
			"compile_cmd": "javac -J-Dfile.encoding=utf8 -d \"{source_file_dir}\" \"{source_file}\"",
			"run_cmd": "java -classpath \"{source_file_dir}\" \"{file_name}\"",
			"time_limit_ms": 5000,
			"memory_limit_mb": 256
		}
	],

	// ================= 判定口径 =================
	// true:  第一个测试失败后停止（默认，最快暴露错误）
	// false: 跑完全部测试（也可用命令 "Run all tests" 临时覆盖）
	"stop_on_first_failure": true,
	// 浮点题容差：0 = 关闭（逐 token 精确比较）。大于 0 时数字型 token 允许
	// 误差 |a-b| <= tol * max(1, |a|, |b|)，例如 1e-6。
	"float_tolerance": 0,
	// PE（格式错误）是否按 AC 处理。false = 严格（PE 单独显示，默认）；
	// true = 许多 OJ 的口径，token 相同但空白不同也算通过。
	"regard_pe_as_ac": false,
	// 单次运行保留的输出上限（字节），超出部分丢弃并在控制台提示，
	// 防止程序在时间限制内疯狂输出把编辑器卡死。默认 8MB。
	"max_output_bytes": 8388608,
	// 逐字符同步输出（只有交互式程序需要）。开启后输出量大时会明显变慢，
	// 因为每个字符都要刷新一次视图。默认关闭。
	"sync_output": false,

	// ================= 编译缓存 =================
	// 源文件（含 extra_sources）和编译命令都没变时跳过编译直接运行。
	// 需要强制重新编译时执行命令 "Run (force recompile)"。
	"compile_cache_enabled": true,

	// 是否在运行面板底部显示汇总行（如 "4/5 通过 · 首个失败 test 3 · 总用时 1.24s"）
	"show_summary_bar": true,

	// ================= 对拍 (Stress Test) =================
	// 对拍时每轮给生成器/用户程序/std 的单轮时间限制(秒)
	"stress_time_limit_seconds": 2,
	// 上次使用的 std 程序 / 数据生成器路径（对拍命令会自动记住）
	"stress_std_file": "",
	"stress_generator_file": "",
	// 对拍发现反例时，自动把它保存成一个正式测试点
	"stress_save_counterexample": true,

	// ================= 模板片段 (Ctrl+Alt+T) =================
	// 光标停在关键字后按 Ctrl+Alt+T 展开。查找顺序：
	//   1. algorithms_base 目录下的 <关键字>.cpp / .cc / .py / .txt
	//   2. 下面的 templates 字典
	//   3. 内置片段（fastio / main / bf / debug / testlib）
	"algorithms_base": null,
	"templates": {
		// 例: "seg": "// 线段树模板\n..."
	},

	// ================= 其他 =================
	// 打开测评面板时是否自动隐藏侧边栏
	"close_sidebar": true,

	// ================= 测试卡片面板自适应宽度 =================
	// 自动加宽右侧运行面板, 直到测试卡片 (AC test 1 / edit / run / detail /
	// time ...) 不会因面板太窄而换行堆叠; 只在需要时加宽, 从不自动收窄。
	"auto_fit_panel_width": true,
	// 面板最大宽度占窗口布局的比例, 0.5 表示最多加宽到半个窗口
	"max_panel_width_ratio": 0.5,

	// 是否在答案比较时忽略标准错误 (cerr / debug 输出)。
	// true: stderr 单独捕获，不参与答案比较（推荐，调试输出不再导致 WA）；
	// false: stderr 混入 stdout 一起比较（旧行为）。
	"ignore_stderr": true,

	// ================= 详情 (detail) 显示模式 =================
	// "view":    打开真实编辑器标签页（可选中复制，纯文本格式，含样例输入）
	// "phantom": 旧版内嵌面板模式（显示在运行视图内部，不可选中文字）
	"detail_style": "view",

	// ================= Competitive Companion 监听 =================
	// "Listen to Competitive Companion" 监听的端口。
	// 启动一次后持续监听（浏览器扩展可反复点击发送）；再次执行该命令
	// 只会切换目标文件；用 "Stop Competitive Companion listener" 停止。
	"companion_port": 12345,

	// ================= 测试数据存储 =================
	// 传统模式: 测试数据存在 "foo.cpp__tests"（同目录）
	"tests_file_suffix": "__tests",
	// 相对源代码目录的子目录（留空 = 直接放同目录）
	"tests_relative_dir": "",
	// cph-ng 模式: 测试数据存放在 "tests/foo.cpp__tests"
	"tests_folder_name": "tests"
}
