[
	{
		"id": "view",
		"children": [
			{
				"caption": "cph-by-chenkx",
				"children": [
					{
						"caption": "Run",
						"command": "view_tester",
						"args": {"action": "make_opd"}
					},
					{
						"caption": "Run with clean tests",
						"command": "view_tester",
						"args": {"action": "make_opd", "clr_tests": true}
					},
					{
						"caption": "Toggle hide phantoms",
						"command": "test_manager",
						"args": {"action": "toggle_hide_phantoms"}
					},
					{
						"caption": "Listen to Competitive Companion",
						"command": "cph_companion_listener"
					},
					{
						"caption": "Import tests from file...",
						"command": "cph_import_tests"
					},
					{
						"caption": "Pick and import test file",
						"command": "cph_pick_import_file"
					},
					{
						"caption": "Start stress test",
						"command": "cph_start_stress_test"
					},
					{
						"caption": "Stop stress test",
						"command": "cph_stop_stress_test"
					},
					{
						"caption": "Switch language",
						"command": "cph_language_toggle_language"
					}
				]
			}
		]
	},
	{
		"caption": "Preferences",
		"mnemonic": "P",
		"id": "preferences",
		"children": [
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children": [
					{
						"caption": "cph-by-chenkx",
						"children": [
							{
								"caption": "Settings",
								"command": "open_file",
								"args": {"file": "${packages}/cph-by-chenkx/cph-by-chenkx (${platform}).sublime-settings"}
							},
							{
								"caption": "README（使用说明）",
								"command": "open_file",
								"args": {"file": "${packages}/cph-by-chenkx/README.md"}
							}
						]
					}
				]
			}
		]
	}
]
