{
	// ================= cph-by-chenkx 设置（中文注释版） =================
	// 保存即生效。建议把要改的项复制到 User 设置里覆盖（Preferences ->
	// Package Settings -> cph-by-chenkx -> Settings），升级插件不会丢配置。

	// 界面语言: "zh" 中文 / "en" 英文（也可用命令面板的 Toggle language 切换）
	"language": "zh",

	// ================= 各语言编译/运行配置 =================
	// 可用占位符:
	//   {source_file}     源代码完整路径
	//   {source_file_dir} 源代码所在目录
	//   {file_name}       不带扩展名的文件名
	//   {args}            附加命令行参数
	//   {extra_sources}   多文件题目：额外的源文件（见 extra_sources 设置）
	//   {include_dirs}    额外 -I 目录（见 include_dirs 设置）
	// 注意: compile_cmd 里 "-o" 后面必须紧跟输出文件名 "{file_name}"，
	//       顺序写错会导致编译失败！
	// 默认命令使用正斜杠（Windows / Linux / macOS 都可用，反斜杠同样有效）。
	// 想改成自己的写法，把 run_settings 复制到 User 设置里覆盖即可。
	"run_settings": [
		{
			"name": "C++",
			"extensions": ["cpp"],
			// 编译命令；{extra_sources} / {include_dirs} 用不到时删掉即可
			// -O2 很重要：不加优化时程序比评测机慢几十倍，本地时限毫无参考价值，
			//   正确代码也会被判 TLE；实测 -O2 几乎不增加编译时间。
			// -std 用 c++17：实测比 c++23 每次编译快约 1.2 秒
			//   （3.4s vs 4.7s，含 <bits/stdc++.h>），也是多数 OJ 的口径。
			"compile_cmd": "g++ \"{source_file}\" {extra_sources} {include_dirs} -std=c++17 -O2 -o \"{file_name}.exe\" -DLOCAL",
			// 运行命令（编译产物在源代码目录下）
			"run_cmd": "\"{source_file_dir}/{file_name}.exe\" {args}",
			// 单个测试的时间限制(毫秒) / 内存限制(MB)，超限判 TLE / MLE
			"time_limit_ms": 2000,
			"memory_limit_mb": 256,
			// 多文件题目：把同目录其它源文件一起编译（glob 通配，可留空）
			"extra_sources": [],
			// 额外头文件目录（可留空）
			"include_dirs": [],

			// ===== 自定义判定器（SPJ，多解题必备）=====
			// 填 checker 源文件（或已编译好的可执行文件）路径即可启用；留空则
			// 仍按逐 token 比较。相对路径按源文件所在目录解析。
			"checker": "",
			// testlib（默认）：checker <输入文件> <用户输出文件> <标准答案文件>
			//   —— 和 testlib 的 argv[1..3] 完全一致，现成 checker 直接用；
			// stdin：把「输入 / 用户输出 / 标准答案」按顺序写到 stdin，
			//   每段之间用一行 --- 分隔（方便写脚本 checker）。
			"checker_style": "testlib",
			// checker 的编译命令（只编译一次，之后复用；已有 .exe 则直接使用）
			"checker_compile_cmd": "g++ -O2 -std=c++17 -I \"{checker_dir}\" \"{checker}\" -o \"{checker}.exe\"",
			// checker 自己的时间限制（毫秒）
			"checker_time_limit_ms": 10000,

			// ===== 交互题（Interactor）=====
			// 填 interactor 源文件（或已编译好的可执行文件）路径即可启用；留空则
			// 按普通题跑。启用后该语言的运行会自动走交互流程（testlib 约定）：
			//   interactor <输入文件> <输出文件> <标准答案文件>
			// 它从 stdin 读选手输出、往 stdout 写要发给选手的内容，退出码即判决
			// （0=AC 1=WA 2=PE 3=FAIL 7=PC）。交互题不并发跑（interactor 通常
			// 不可重入）。
			"interactor": "",
			"interactor_compile_cmd": "g++ -O2 -std=c++17 -I \"{interactor_dir}\" \"{interactor}\" -o \"{interactor}.exe\"",
			"interactor_time_limit_ms": 20000
		},
		{
			"name": "Python",
			"extensions": ["py"],
			// Python 无需编译，置为 null
			"compile_cmd": null,
			"run_cmd": "python \"{source_file}\"",
			"time_limit_ms": 5000,
			"memory_limit_mb": 256
		},
		{
			"name": "Java",
			"extensions": ["java"],
			"compile_cmd": "javac -J-Dfile.encoding=utf8 -d \"{source_file_dir}\" \"{source_file}\"",
			"run_cmd": "java -classpath \"{source_file_dir}\" \"{file_name}\"",
			"time_limit_ms": 5000,
			"memory_limit_mb": 256
		},
		{
			"name": "C",
			"extensions": ["c"],
			"compile_cmd": "gcc \"{source_file}\" {extra_sources} {include_dirs} -std=c17 -O2 -o \"{file_name}.exe\" -DLOCAL",
			"run_cmd": "\"{source_file_dir}/{file_name}.exe\" {args}",
			"time_limit_ms": 2000,
			"memory_limit_mb": 256,
			"extra_sources": [],
			"include_dirs": []
		},
		{
			"name": "Rust",
			"extensions": ["rs"],
			"compile_cmd": "rustc -O \"{source_file}\" -o \"{file_name}.exe\"",
			"run_cmd": "\"{source_file_dir}/{file_name}.exe\" {args}",
			"time_limit_ms": 2000,
			"memory_limit_mb": 256
		},
		{
			"name": "Go",
			"extensions": ["go"],
			// go build 会在当前目录生成可执行文件，-o 指定名字即可
			"compile_cmd": "go build -o \"{file_name}.exe\" \"{source_file}\"",
			"run_cmd": "\"{source_file_dir}/{file_name}.exe\" {args}",
			"time_limit_ms": 2000,
			"memory_limit_mb": 256
		},
		{
			"name": "Pascal",
			"extensions": ["pas", "pp"],
			"compile_cmd": "fpc -O2 -o\"{file_name}.exe\" \"{source_file}\"",
			"run_cmd": "\"{source_file_dir}/{file_name}.exe\" {args}",
			"time_limit_ms": 2000,
			"memory_limit_mb": 256
		},
		{
			"name": "JavaScript (Node.js)",
			"extensions": ["js", "mjs", "cjs"],
			// Node 直接跑源码，无需编译
			"compile_cmd": null,
			"run_cmd": "node \"{source_file}\"",
			"time_limit_ms": 5000,
			"memory_limit_mb": 256
		}
	],

	// ================= 判定口径 =================
	// true:  第一个测试失败后停止（默认，最快暴露错误）
	// false: 跑完全部测试（也可用命令 "Run all tests" 临时覆盖）
	"stop_on_first_failure": true,
	// 浮点题容差：0 = 关闭（逐 token 精确比较）。大于 0 时数字型 token 允许
	// 误差 |a-b| <= tol * max(1, |a|, |b|)，例如 1e-6。
	"float_tolerance": 0,
	// PE（格式错误）是否按 AC 处理。false = 严格（PE 单独显示，默认）；
	// true = 许多 OJ 的口径，token 相同但空白不同也算通过。
	"regard_pe_as_ac": false,
	// 单次运行保留的输出上限（字节），超出部分丢弃并在控制台提示，
	// 防止程序在时间限制内疯狂输出把编辑器卡死。默认 8MB。
	"max_output_bytes": 8388608,
	// 逐字符同步输出（只有交互式程序需要）。开启后输出量大时会明显变慢，
	// 因为每个字符都要刷新一次视图。默认关闭。
	"sync_output": false,

	// ================= Benchmark（卡常对比） =================
	// "Benchmark this test" 会把当前测试点跑几次，报告最快/平均/最慢。
	// 单次测量被进程启动和调度噪声主导，跑多次才看得出常数差异。
	"benchmark_runs": 5,

	// ================= 保存后自动运行 / 自动格式化（默认关闭） =================
	// 打开后保存源文件就会自动跑一次测试（带防抖，连续保存只跑最后一次）。
	"auto_run_on_save": false,
	"auto_run_debounce_seconds": 0.8,
	// 保存后调用该语言的 format_cmd（见 run_settings，例如 clang-format），
	// 文件真的被改了才重新载入视图。
	"auto_format_on_save": false,

	// ================= Competitive Companion 自动建文件 =================
	// 收到题目时如果当前视图还没有文件（新建未保存），自动建
	// <auto_create_dir>/<题目标题>.<auto_create_extension> 并打开。
	"auto_create_file": true,
	// 留空 = 用窗口第一个文件夹；也可以是绝对路径或相对当前文件的路径
	"auto_create_dir": "",
	"auto_create_extension": "cpp",
	// 新建文件时写入的内容（可放你的模板；留空则是空文件）
	"auto_create_template": "",

	// ================= 练习统计 =================
	// "Show practice statistics" 报告的默认天数
	"stats_days": 7,

	// ================= 比赛计时 =================
	// 收到题目时自动开始倒计时（分钟）；0 = 关闭。也可手动 Ctrl+Alt+Shift+T。
	"contest_duration_minutes": 0,

	// ================= Subtask 分组 =================
	// 测试点分组（NOI 系）：组内全部 AC 才算这组通过，汇总行显示部分分。
	// 例：[{"name": "Sub1", "from": 1, "to": 3, "score": 30},
	//      {"name": "Sub2", "from": 4, "to": 10, "score": 70}]
	// from/to 是测试点序号（从 1 开始，含两端）。
	"subtasks": [],

	// ================= 并行运行测试点 =================
	// "Run all tests in parallel"（Ctrl+Alt+Shift+P）用的 worker 数。
	// 串行跑时，5 个点里有 2 个 TLE 就要干等 2×时限；并行大约只要 1/4。
	// 每个测试点用独立的进程，互不影响。设为 1 即退回串行。
	"parallel_workers": 4,

	// ================= 编译模式（Debug / Release） =================
	// 新打开的文件用哪种编译模式；随时可用 Ctrl+Alt+G 切换（按文件记忆，
	// 不会写进这个设置文件）。
	//   release：保证带 -O2，去掉 sanitizer 参数 —— 计时用，速度与评测机可比
	//   debug  ：去掉优化，加 -g -fsanitize=address,undefined
	//            —— 崩溃时输出 文件:行:列，详情视图里可以直接点着跳过去
	"build_mode": "release",

	// ================= 编译缓存 =================
	// 源文件（含 extra_sources）和编译命令都没变时跳过编译直接运行。
	// 需要强制重新编译时执行命令 "Run (force recompile)"。
	"compile_cache_enabled": true,

	// 是否在运行面板底部显示汇总行（如 "4/5 通过 · 首个失败 test 3 · 总用时 1.24s"）
	"show_summary_bar": true,

	// ================= 对拍 (Stress Test) =================
	// 对拍时每轮给用户程序/std 的单轮时间限制(秒)
	"stress_time_limit_seconds": 2,
	// 生成器的单轮时间限制(秒)。造数据比解题慢，所以单独放宽；
	// 太小会把"生成器超时"误报成"生成器失败"。
	"stress_generator_time_limit_seconds": 10,
	// 对拍的最大轮数（直接开始对拍时使用；"Stress test with options" 会询问）
	"stress_max_rounds": 1000,
	// 对拍总时长上限(秒)，0 表示不限制。跑很久的对拍到点会自动停下并报告
	"stress_max_wall_seconds": 0,
	// 找不到 std / 生成器时用什么方式挑文件：
	//   "auto"   — Windows 用系统打开文件对话框，其它平台用命令面板浏览
	//   "native" — 总是用系统对话框
	//   "panel"  — 总是用 Sublime 命令面板浏览
	// 无论哪种，起始目录都是当前源文件所在的目录。
	"stress_file_picker": "auto",
	// 上次使用的 std 程序 / 数据生成器路径（对拍命令会自动记住）
	"stress_std_file": "",
	"stress_generator_file": "",
	// 对拍发现反例时，自动把它保存成一个正式测试点
	"stress_save_counterexample": true,

	// ================= 模板片段 (Ctrl+Alt+T) =================
	// 光标停在关键字后按 Ctrl+Alt+T 展开。查找顺序：
	//   1. algorithms_base 目录下的 <关键字>.cpp / .cc / .py / .txt
	//   2. 下面的 templates 字典
	//   3. 内置片段（fastio / main / bf / debug / testlib）
	"algorithms_base": null,
	"templates": {
		// 例: "seg": "// 线段树模板\n..."
	},

	// ================= 其他 =================
	// 打开测评面板时是否自动隐藏侧边栏
	"close_sidebar": true,

	// 右键菜单里是否显示本插件的项。只看相关文件（run_settings 里的扩展名），
	// 设为 false 可以完全不显示；命令面板和 View 菜单不受影响。
	"context_menu": true,

	// 包内快捷键（ctrl+alt+t / ctrl+alt+b / ctrl+alt+s ... 那一批）是否生效。
	// 这些绑定随包加载、随包卸载：禁用或卸载本插件后按键会自动还给其它插件，
	// 不会再占着键位。设成 false 则可以在**不改 keymap** 的情况下临时让出键位
	// （运行面板内部的 enter / ctrl+d 等绑定不受影响，它们只在本插件自己的
	// 视图里生效）。
	"enable_keybindings": true,

	// ================= 测试卡片面板自适应宽度 =================
	// 自动加宽右侧运行面板, 直到测试卡片 (AC test 1 / edit / run / detail /
	// time ...) 不会因面板太窄而换行堆叠; 只在需要时加宽, 从不自动收窄。
	"auto_fit_panel_width": true,
	// 面板最大宽度占窗口布局的比例, 0.5 表示最多加宽到半个窗口
	"max_panel_width_ratio": 0.5,

	// 是否在答案比较时忽略标准错误 (cerr / debug 输出)。
	// true: stderr 单独捕获，不参与答案比较（推荐，调试输出不再导致 WA）；
	// false: stderr 混入 stdout 一起比较（旧行为）。
	"ignore_stderr": true,

	// ================= 详情 (detail) 显示模式 =================
	// "view":    打开真实编辑器标签页（可选中复制，纯文本格式，含样例输入）
	// "phantom": 旧版内嵌面板模式（显示在运行视图内部，不可选中文字）
	"detail_style": "view",

	// ================= Competitive Companion 监听 =================
	// "Listen to Competitive Companion" 监听的端口。
	// 启动一次后持续监听（浏览器扩展可反复点击发送）；再次执行该命令
	// 只会切换目标文件；用 "Stop Competitive Companion listener" 停止。
	"companion_port": 12345,

	// ================= 测试数据存储 =================
	// 传统模式: 测试数据存在 "foo.cpp__tests"（同目录）
	"tests_file_suffix": "__tests",
	// 相对源代码目录的子目录（留空 = 直接放同目录）
	"tests_relative_dir": "",
	// cph-ng 模式: 测试数据存放在 "tests/foo.cpp__tests"
	"tests_folder_name": "tests"
}
