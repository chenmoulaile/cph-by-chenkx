%YAML 1.2
---
name: DetailSyntax
hidden: false
file_extensions: []
scope: source.DetailSyntax

contexts:
  main:
    # ==== divider lines ====
    - match: '^=+[ \t]*$'
      scope: comment.line.detail
    # diff: expected-only line (red in default themes) - must come before
    # the generic header rule so "- expected: a | b" stays a diff line
    - match: '^- .*$'
      scope: markup.deleted.diff
    # diff: actual-only line (green in default themes)
    - match: '^\+.+$'
      scope: markup.inserted.diff
    # [section] headers
    - match: '^\[[^\]]*\][^\n]*$'
      scope: entity.name.section.detail
    # diff line numbers ("  Line 2:")
    - match: '^[ \t]*Line [0-9]+:'
      scope: constant.numeric.detail
    # "Test 1  |  WA  |  Time: 12ms" header line
    - match: '^[^\n]*\|.*$'
      scope: entity.name.section.detail.header
    # summary lines starting with a number ("3 line(s) ...")
    - match: '^[0-9]+[ \t].*$'
      scope: string.unquoted.detail
